# Set OLD_KUBE_TAG to the kubernetes version that was previously rebased
# onto and KUBE_TAG to the version to rebase onto now without the "v"
# prefix.
# E.g. if the last rebase was targeting v1.35.1 and the current version
# is v1.36.0 the value is "1.35.1" and "1.36.0" respectively.
export OLD_KUBE_TAG="1.35.1"
export KUBE_TAG="1.36.0"

## Do not edit after this point unless there is a specific problem. The scripts depend on these values.
if [[ -z "$KUBE_TAG" ]]; then
    echo "KUBE_TAG is empty"
    exit 1
fi

## TODO: Drop this
# for scripts have an anchor regardless of where they cd to
export PATCHES_ROOT="$(realpath "$(pwd)")"

# for go commands to always use the built go.work
export GOWORK="$PATCHES_ROOT/go.work"
## TODO END: Drop this

export KUBE_1_TAG="$KUBE_TAG"
export KUBE_0_TAG="${KUBE_TAG/1./0.}"

export OLD_KUBE_1_TAG="$OLD_KUBE_TAG"
export OLD_KUBE_0_TAG="${OLD_KUBE_TAG/1./0.}"
