From 7a3ec307b0c77ca4b149aeb8221f35433439d14e Mon Sep 17 00:00:00 2001
From: "Dr. Stefan Schimanski" <stefan.schimanski@gmail.com>
Date: Wed, 27 Sep 2023 14:33:26 +0200
Subject: [PATCH 07/90] UPSTREAM: <carry>: registry/core/serviceaccount: do not
 crash without pods

Signed-off-by: Dr. Stefan Schimanski <stefan.schimanski@gmail.com>
---
 pkg/registry/core/serviceaccount/storage/storage.go | 2 +-
 pkg/registry/core/serviceaccount/storage/token.go   | 5 +++++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/pkg/registry/core/serviceaccount/storage/storage.go b/pkg/registry/core/serviceaccount/storage/storage.go
index c1a4d250d71..f7c64708e50 100644
--- a/pkg/registry/core/serviceaccount/storage/storage.go
+++ b/pkg/registry/core/serviceaccount/storage/storage.go
@@ -59,7 +59,7 @@ func NewREST(optsGetter generic.RESTOptionsGetter, issuer token.TokenGenerator,
 	}
 
 	var trest *TokenREST
-	if issuer != nil && podStorage != nil && secretStorage != nil {
+	if issuer != nil && (podStorage != nil || secretStorage != nil) {
 		trest = &TokenREST{
 			svcaccts:                     store,
 			pods:                         podStorage,
diff --git a/pkg/registry/core/serviceaccount/storage/token.go b/pkg/registry/core/serviceaccount/storage/token.go
index e4e63895aa3..1d22655ff95 100644
--- a/pkg/registry/core/serviceaccount/storage/token.go
+++ b/pkg/registry/core/serviceaccount/storage/token.go
@@ -160,6 +160,11 @@ func (r *TokenREST) Create(ctx context.Context, name string, obj runtime.Object,
 		gvk := schema.FromAPIVersionAndKind(ref.APIVersion, ref.Kind)
 		switch {
 		case gvk.Group == "" && gvk.Kind == "Pod":
+			if r.pods == nil {
+				// TODO(sttts): kubelet will try to create bound tokens against the pcluster, but those obviously
+				//              will not work against kcp. ¯\_(ツ)_/¯
+				return nil, errors.NewBadRequest("spec.BoundObjectRef.Kind equal to Pod is invalid")
+			}
 			newCtx := newContext(ctx, "pods", ref.Name, namespace, gvk)
 			podObj, err := r.pods.Get(newCtx, ref.Name, &metav1.GetOptions{})
 			if err != nil {
-- 
