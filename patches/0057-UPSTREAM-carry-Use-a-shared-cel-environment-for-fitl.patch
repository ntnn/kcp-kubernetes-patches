From 103adbb7d7a38a1e5fa06fb2dcd228d8c58eede9 Mon Sep 17 00:00:00 2001
From: "Nelo-T. Wallus" <n.wallus@sap.com>
Date: Tue, 16 Dec 2025 14:55:50 +0100
Subject: [PATCH 57/73] UPSTREAM: <carry>: Use a shared cel environment for
 fitlerCompiler

Signed-off-by: Nelo-T. Wallus <red.brush9525@fastmail.com>
Signed-off-by: Nelo-T. Wallus <n.wallus@sap.com>
---
 .../apiserver/pkg/admission/plugin/webhook/generic/webhook.go | 3 +--
 .../pkg/admission/plugin/webhook/generic/webhook_kcp.go       | 4 ++++
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/generic/webhook.go b/staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/generic/webhook.go
--- a/staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/generic/webhook.go
+++ b/staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/generic/webhook.go
@@ -21,7 +21,6 @@ import (
 	"fmt"
 	"io"
 
-	"k8s.io/apiserver/pkg/cel/environment"
 	"k8s.io/klog/v2"
 
 	admissionv1 "k8s.io/api/admission/v1"
@@ -100,7 +99,7 @@ func NewWebhook(handler *admission.Handler, configFile io.Reader, sourceFactory
 		namespaceMatcher: &namespace.Matcher{},
 		objectMatcher:    &object.Matcher{},
 		dispatcher:       dispatcherFactory(&cm),
-		filterCompiler:   cel.NewConditionCompiler(environment.MustBaseEnvSet(environment.DefaultCompatibilityVersion())),
+		filterCompiler:   sharedFilterCompiler,
 	}, nil
 }
 
diff --git a/staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/generic/webhook_kcp.go b/staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/generic/webhook_kcp.go
--- a/staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/generic/webhook_kcp.go
+++ b/staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/generic/webhook_kcp.go
@@ -1,6 +1,8 @@
 package generic
 
 import (
+	"k8s.io/apiserver/pkg/admission/plugin/cel"
+	"k8s.io/apiserver/pkg/cel/environment"
 	coreinformers "k8s.io/client-go/informers/core/v1"
 )
 
@@ -17,3 +19,5 @@ func (a *Webhook) SetReadyFuncFromKCP(namespaceInformer coreinformers.NamespaceI
 		return namespaceInformer.Informer().HasSynced() && a.hookSource.HasSynced()
 	})
 }
+
+var sharedFilterCompiler = cel.NewConditionCompiler(environment.MustBaseEnvSet(environment.DefaultCompatibilityVersion()))
